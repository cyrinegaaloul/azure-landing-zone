type: install
name: Landing Zone Demo Backend (production)
settings:
  fields:
    - name: backendImage
      caption: Backend container image
      type: string
      required: true
    - name: backendPort
      caption: Backend HTTP port
      type: string
      default: "8080"
nodes:
  - nodeType: docker
    image: "${settings.backendImage}"
    env:
      APP_ENV: prod
      APP_PORT: "${settings.backendPort}"
