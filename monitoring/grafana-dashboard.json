{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "demo_app_uptime_seconds{namespace=\"demo\"}", "legendFormat": "uptime", "refId": "A"}],
      "title": "Application uptime",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(rate(demo_app_http_requests_total{namespace=\"demo\"}[5m]))", "legendFormat": "requests", "refId": "A"}],
      "title": "Request rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [{"expr": "sum(rate(demo_app_http_request_errors_total{namespace=\"demo\"}[5m]))", "legendFormat": "errors", "refId": "A"}],
      "title": "Error rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 4,
      "targets": [{"expr": "sum(rate(demo_app_http_request_duration_seconds_sum{namespace=\"demo\"}[5m])) / clamp_min(sum(rate(demo_app_http_requests_total{namespace=\"demo\"}[5m])), 0.001)", "legendFormat": "average", "refId": "A"}],
      "title": "Average request latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "cores"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 5,
      "targets": [{"expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"demo\",container=\"landing-zone-demo-app\"}[5m]))", "legendFormat": "CPU", "refId": "A"}],
      "title": "Pod CPU usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "id": 6,
      "targets": [{"expr": "sum(container_memory_working_set_bytes{namespace=\"demo\",container=\"landing-zone-demo-app\"})", "legendFormat": "memory", "refId": "A"}],
      "title": "Pod memory usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "id": 7,
      "targets": [
        {"expr": "kube_deployment_spec_replicas{namespace=\"demo\",deployment=\"landing-zone-demo-app\"}", "legendFormat": "desired", "refId": "A"},
        {"expr": "kube_deployment_status_replicas_available{namespace=\"demo\",deployment=\"landing-zone-demo-app\"}", "legendFormat": "available", "refId": "B"}
      ],
      "title": "Deployment replicas",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["azure-landing-zone", "demo"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "title": "Landing Zone Demo Application",
  "uid": "landing-zone-demo-app",
  "version": 2
}
