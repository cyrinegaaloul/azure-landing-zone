# Copy to terraform.tfvars and replace only the subscription ID. No GitHub or
# Entra principal IDs are required; Terraform creates/discovers them.
subscription_id = "00000000-0000-0000-0000-000000000000"

location     = "francecentral"
project_name = "alz"
environment  = "dev"
owner        = "cyrine"

# Grants the identity running this bootstrap Storage Blob Data Contributor so
# local Terraform can use Entra authentication for the remote backend.
grant_current_user_backend_access = true
