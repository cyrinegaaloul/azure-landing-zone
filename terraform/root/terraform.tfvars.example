# Copy this file to terraform.tfvars for local use. The copied file is ignored
# by Git. Replace the zero UUIDs locally or supply them with TF_VAR_* variables.
# Do not commit subscription IDs, tenant IDs, principal IDs, or secret values.
subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"

# Foundation and naming
location     = "francecentral"
project_name = "alz"
environment  = "dev"
owner        = "cyrine"

# Network layout. These CIDRs are also rendered into the deployment-specific
# Kubernetes NetworkPolicy by the controlled deployment workflow.
vnet_address_space = ["10.10.0.0/16"]

subnets = {
  management = {
    address_prefixes = ["10.10.0.0/24"]
    create_nsg       = true
  }
  private-endpoints = {
    address_prefixes = ["10.10.1.0/24"]
    create_nsg       = true
  }
  aks = {
    address_prefixes = ["10.10.2.0/24"]
    create_nsg       = true
  }
  appgw = {
    address_prefixes = ["10.10.3.0/24"]
    create_nsg       = true
  }
  apim = {
    address_prefixes = ["10.10.4.0/24"]
    create_nsg       = true
  }
}

# Additional environment-specific NSG rules. The application-path and Azure
# platform rules are generated by the root module and do not belong here.
nsg_rules = {}

# Human RBAC assignments are optional. Set real object IDs only in the ignored
# local file or through TF_VAR_* environment variables.
role_assignments                       = {}
platform_admin_group_object_id         = null
network_operator_group_object_id       = null
security_reader_group_object_id        = null
aks_deployer_principal_object_id       = null
key_vault_bootstrap_principal_object_id = null

# Optional custom locks remain empty; the secure profile generates the network
# and security resource-group locks through enable_resource_group_locks.
resource_group_locks        = {}
enable_resource_group_locks = false

# Safe/core profile: no billable application stack is created.
enable_key_vault                        = false
enable_key_vault_private_endpoint       = false
enable_key_vault_purge_protection       = false
key_vault_public_network_access_enabled = true
enable_aks_demo                         = false
enable_edge_stack                       = false
enable_apim                             = false

# Management access remains disabled unless AKS is enabled deliberately.
enable_management_access = false

# Development defaults used when the related components are enabled.
waf_policy_mode = "Detection"
apim_sku_name   = "Developer_1"

aks_node_count                     = 1
aks_node_vm_size                   = "Standard_B2s_v2"
aks_internal_load_balancer_ip      = "10.10.2.250"
aks_api_server_authorized_ip_ranges = []
aks_automatic_upgrade_channel       = "patch"
aks_node_os_upgrade_channel         = "NodeImage"

# Functional profile options
#
# Key Vault bootstrap:
#   enable_key_vault                        = true
#   key_vault_public_network_access_enabled = true
#   Set key_vault_bootstrap_principal_object_id locally when required.
#
# Full demo:
#   enable_key_vault                        = true
#   enable_key_vault_private_endpoint       = true
#   key_vault_public_network_access_enabled = false
#   enable_aks_demo                         = true
#   enable_edge_stack                       = true
#   enable_apim                             = true
#
# Secure demo uses all full-demo values plus:
#   enable_resource_group_locks = true
#   waf_policy_mode             = "Prevention"
#
# Purge protection remains false for a temporary, destroyable demonstration.
